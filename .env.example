# DecisionDeck Environment Configuration

# Application settings
APP_ENV=development
APP_SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database settings
# For local development SQLite is used by default if DATABASE_URL is not set:
DATABASE_URL=sqlite:///./decisiondeck.db
# For production (e.g. Supabase PostgreSQL):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
